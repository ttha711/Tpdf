# Tpdf Agent Web bridge - copy into private deployment environment only.
# Do not commit populated values. Never expose secrets through VITE_*.
TPDF_HOST=127.0.0.1
TPDF_PORT=8787
TPDF_PUBLIC_ORIGIN=https://pdf.example.test
TPDF_AUTH_MODE=local
TPDF_AUTH_SECRET=replace-with-unique-random-secret-at-least-32-chars
# Only for first Tpdf local-auth initialization:
TPDF_BOOTSTRAP_EMAIL=admin@example.test
TPDF_BOOTSTRAP_PASSWORD=replace-with-long-admin-password
TPDF_AGENT_WEB_BRIDGE_SECRET=replace-with-same-unique-secret-as-agent-web-32-plus-chars
TPDF_AGENT_WEB_ORIGINS=https://agent.example.test
TPDF_AGENT_WEB_QUOTA_BYTES=10737418240
TPDF_MAX_OPERATION_BYTES=262144000
# Agent Web service (set over there, not consumed by Tpdf):
# TPDF_AGENT_WEB_BASE_URL=https://pdf.example.test
